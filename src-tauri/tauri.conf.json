{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BrakeTune",
  "version": "../package.json",
  "identifier": "com.szpolny.braketune",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BrakeTune",
        "width": 400,
        "height": 580,
        "decorations": false,
        "resizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Brake force control for Fanatec pedals",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/70-braketune.rules": "udev/70-braketune.rules"
        }
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/70-braketune.rules": "udev/70-braketune.rules"
        }
      }
    }
  }
}
